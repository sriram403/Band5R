# Godot editor/runtime binaries: 171 MB, over GitHub's file limit. See README "Setup".
tools/godot/*.exe
# Editor settings and caches written by the self-contained editor
tools/godot/editor_data/
# user:// data redirected here by Play.bat (settings, logs, shader cache)
appdata/
# Godot import cache, regenerated on first open
FindingNaresh/.godot/
# Screenshots from the capture and play-test modes, regenerated by running them
FindingNaresh/_shots/
# Downloaded asset packs (the used files are copied into FindingNaresh/)
assets_src/
