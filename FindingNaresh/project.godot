; Finding Naresh: Bessi and the 5 Roses
; Godot 4.7 project configuration

config_version=5

[application]

config/name="Finding Naresh: Bessi and the 5 Roses"
config/description="Two-player cooperative road-trip adventure. Prototype stage."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
; user:// (settings, logs, shader cache, future saves) is %APPDATA%/FindingNaresh.
; Godot always roots this at %APPDATA%, so Play.bat and OpenEditor.bat point
; APPDATA at MPG/appdata to keep it off C:. An absolute path here does NOT work:
; Godot appends it under %APPDATA% on C: instead.
config/use_custom_user_dir=true
config/custom_user_dir_name="FindingNaresh"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="GodotPhysics3D"
common/physics_ticks_per_second=60
; Physics runs at 60 Hz but monitors are often faster (the dev machine is
; 144 Hz). Interpolation renders bodies between ticks so motion is not juddery.
common/physics_interpolation=true

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
textures/default_filters/anisotropic_filtering_level=2

[input_devices]

pointing/emulate_touch_from_mouse=false
