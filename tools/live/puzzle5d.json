{
 "name": "puzzle5d",
 "setup": [
  {
   "do": "eval",
   "expr": "boot._on_joy_changed(0, true)"
  }
 ],
 "steps": [
  {
   "name": "5.0 F1 Puzzles: the lift bridge",
   "max": 20,
   "do": [
    {
     "do": "menu",
     "tab": "Puzzles",
     "row": "The lift bridge"
    },
    {
     "do": "wait",
     "s": 2.0
    },
    {
     "do": "eval",
     "expr": "lb().gate.set('_wind_t', 99999.0)"
    }
   ],
   "expect": [
    {
     "name": "at rest",
     "expr": "absf(lb().angle - 12.0) < 0.1",
     "within": 3
    }
   ]
  },
  {
   "name": "5.9 (cut) a cart on the flap in the van's line, the van behind it",
   "max": 30,
   "do": [
    {
     "do": "call",
     "fn": "shove_setup"
    },
    {
     "do": "wait",
     "s": 1.5
    }
   ],
   "expect": []
  },
  {
   "name": "5.10 the van runs into the cart: over the side, the van thrown back, the can flies",
   "max": 40,
   "do": [
    {
     "do": "down",
     "key": "W"
    },
    {
     "do": "until",
     "expr": "lb().carts[0]['lost']",
     "max": 10
    },
    {
     "do": "up",
     "key": "W"
    },
    {
     "do": "wait",
     "s": 3.0
    }
   ],
   "expect": [
    {
     "name": "the cart went over",
     "expr": "lb().carts[0]['lost'] or lb().failing",
     "within": 2
    }
   ]
  },
  {
   "name": "5.11 back at the gate",
   "max": 30,
   "do": [
    {
     "do": "until",
     "expr": "not lb().failing",
     "max": 15
    },
    {
     "do": "wait",
     "s": 3.0
    }
   ],
   "expect": [
    {
     "name": "the van back at the gate",
     "expr": "camper().global_position.distance_to(lb().van_start.origin) < 3.0",
     "within": 3
    }
   ]
  }
 ]
}