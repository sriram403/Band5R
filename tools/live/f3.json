{
 "name": "f3",
 "setup": [
  {
   "do": "eval",
   "expr": "boot._on_joy_changed(0, true)"
  }
 ],
 "steps": [
  {
   "name": "F3.0 jump",
   "do": [
    {
     "do": "menu",
     "tab": "Story",
     "row": "Nearly out of fuel"
    }
   ],
   "expect": [
    {
     "name": "at the village, fuel low",
     "expr": "boot.story.current()['id'] == 'village' and boot.camper.fuel < 3.0",
     "within": 3
    }
   ]
  },
  {
   "name": "F3.2 send him out",
   "do": [
    {
     "do": "walk",
     "who": 1,
     "to": [
      1690,
      0,
      -550
     ],
     "arrive": 2,
     "max": 60
    },
    {
     "do": "job",
     "who": 1,
     "at": [
      1833.96,
      -1.4,
      -584.0
     ],
     "job": "go",
     "zoom": true
    },
    {
     "do": "walk",
     "who": 2,
     "to": [
      1693,
      0,
      -552
     ],
     "arrive": 2,
     "max": 60
    }
   ],
   "expect": [
    {
     "name": "Naresh at the jetty end",
     "expr": "boot.naresh.global_position.distance_to(Vector3(1833.96, -1.4, -584.0)) < 3.0",
     "within": 45,
     "watch": true
    },
    {
     "name": "the shed side clear",
     "expr": "creatures_near(boot.builder.poi['net_shed'], 25.0) == 0 and creatures_near(Vector3(1805, -1.4, -584), 40.0) == 2",
     "within": 60,
     "watch": true
    }
   ]
  },
