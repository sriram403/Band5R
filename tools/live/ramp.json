{
 "name": "ramp",
 "setup": [
  {
   "do": "eval",
   "expr": "boot._on_joy_changed(0, true)"
  }
 ],
 "steps": [
  {
   "name": "1 F1 Puzzles: the ramp jump: in the van at the run-up",
   "max": 25,
   "do": [
    {
     "do": "menu",
     "tab": "Puzzles",
     "row": "The ramp jump"
    },
    {
     "do": "wait",
     "s": 2.0
    }
   ],
   "expect": [
    {
     "name": "the van at the run-up, not jumped",
     "expr": "camper().global_position.distance_to(rj().van_start.origin) < 6.0 and not rj().jumped",
     "within": 3
    }
   ]
  },
  {
   "name": "2 out at the ramp (a cut): the ramp from the road, Naresh's note",
   "max": 45,
   "do": [
    {
     "do": "tap",
     "key": "E"
    },
    {
     "do": "wait",
     "s": 0.6
    },
    {
     "do": "pad_tap",
     "btn": "X"
    },
    {
     "do": "wait",
     "s": 0.6
    },
    {
     "do": "call",
     "fn": "place_player",
     "args": [
      "p1",
      "expr:rj().global_transform * Vector3(3.8, 0.5, 12.5)",
      0.0
     ]
    },
    {
     "do": "call",
     "fn": "place_player",
     "args": [
      "p2",
      "expr:rj().global_transform * Vector3(-1.0, 0.5, 13.0)",
      0.0
     ]
    },
    {
     "do": "look",
     "who": 2,
     "at": "expr:rj().global_transform * Vector3(0, 0.8, 0)"
    },
    {
     "do": "wait",
     "s": 2.0
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:rj().global_transform * Vector3(3.8, 1.2, 7.0)"
    },
    {
     "do": "wait",
     "s": 0.5
    },
    {
     "do": "walk",
     "who": 1,
     "to": "expr:rj().global_transform * Vector3(3.8, 0.3, 7.8)",
     "arrive": 0.3,
     "max": 8
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:rj().global_transform * Vector3(3.8, 1.2, 7.06)"
    },
    {
     "do": "wait",
     "s": 0.5
    },
    {
     "do": "tap",
     "key": "E"
    },
    {
     "do": "wait",
     "s": 4.0
    },
    {
     "do": "tap",
     "key": "E"
    },
    {
     "do": "wait",
     "s": 0.5
    }
   ],
   "expect": []
  },
  {
   "name": "3 from the ramp's top: the gap, the rusted car in the river, the far hut",
   "max": 30,
   "do": [
    {
     "do": "call",
     "fn": "place_player",
     "args": [
      "p1",
      "expr:rj().global_transform * Vector3(0, 1.3, 1.0)",
      0.0
     ]
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:rj().global_transform * Vector3(0, -1.0, -rj().gap_len)"
