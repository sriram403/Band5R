   "max": 60,
   "do": [
    {
     "do": "call",
     "fn": "ramp_film_can"
    },
    {
     "do": "call",
     "fn": "place_player",
     "args": [
      "p2",
      "expr:rj().global_transform * Vector3(-3.9, 0.6, -rj().gap_len - 7.0)",
      0.0
     ]
    },
    {
     "do": "look",
     "who": 2,
     "at": "expr:rj().global_transform * Vector3(0, 0.8, 0)"
    },
    {
     "do": "wait",
     "s": 0.3
    },
    {
     "do": "spawn",
     "fn": "ramp_try",
     "args": [
      80.0
     ]
    },
    {
     "do": "until",
