    {
     "do": "wait",
     "s": 3.5
    },
    {
     "do": "hold",
     "key": "S",
     "s": 2.5
    },
    {
     "do": "tap",
     "key": "SPACE"
    },
    {
     "do": "wait",
     "s": 1.5
