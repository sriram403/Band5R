    {
     "do": "wait",
     "s": 2.5
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:rj().hut.global_position + Vector3(0, 2.5, 0)"
    },
    {
     "do": "wait",
     "s": 2.0
    }
   ],
   "expect": []
  },
  {
   "name": "4 too slow (P2 watching from the near deck): 48 km/h, into the river",
   "max": 70,
   "do": [
    {
     "do": "call",
     "fn": "ramp_start"
    },
    {
     "do": "call",
     "fn": "place_player",
     "args": [
      "p2",
      "expr:rj().global_transform * Vector3(-3.7, 0.6, 2.5)",
      0.0
     ]
    },
    {
     "do": "look",
     "who": 2,
     "at": "expr:rj().global_transform * Vector3(0, -1.5, -rj().gap_len * 0.5)"
    },
    {
     "do": "wait",
     "s": 0.3
    },
    {
     "do": "spawn",
     "fn": "ramp_try",
     "args": [
      48.0
     ]
    },
    {
     "do": "until",
     "expr": "rj().misses > 0",
     "max": 30
    },
    {
     "do": "wait",
     "s": 6.0
    }
   ],
   "expect": [
    {
     "name": "back at the run-up, nothing lost",
     "expr": "camper().global_position.distance_to(rj().van_start.origin) < 5.0 and not camper().wheel_off and not rj().jumped and p1().seat != null",
     "within": 4
    }
   ]
  },
  {
