    },
    {
     "do": "wait",
     "s": 0.3
    },
    {
     "do": "pad_tap",
     "btn": "X"
    },
    {
     "do": "wait",
     "s": 0.6
    },
    {
     "do": "walk",
     "who": 2,
     "to": "expr:relay_throw_spot()",
     "arrive": 0.5,
     "max": 30
    },
    {
     "do": "look",
