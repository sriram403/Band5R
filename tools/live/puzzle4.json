     "who": 2,
     "at": "expr:p1().head.global_position + Vector3(0, -0.3, 0)"
    },
    {
     "do": "wait",
     "s": 0.6
    },
    {
     "do": "pad_tap",
     "btn": "RB"
    },
    {
     "do": "wait",
     "s": 1.6
    },
    {
     "do": "wait",
     "s": 1.0
    }
   ],
   "expect": [
    {
     "name": "P1: SPLAT",
     "expr": "boot.huds[0]._note_text.text.contains('SPLAT')",
     "within": 3
