    {
     "do": "wait",
     "s": 0.6
    },
    {
     "do": "pad_tap",
     "btn": "RB"
    },
    {
     "do": "wait",
     "s": 1.6
    },
    {
     "do": "walk",
     "who": 2,
     "to": "expr:lk_at(-2.6, 0.2, 4.2)",
     "arrive": 0.5,
     "max": 30
    },
    {
     "do": "look",
     "who": 2,
     "at": "expr:relay_patch(2) + Vector3(0, 0.2, 0)"
    },
    {
     "do": "wait",
     "s": 0.3
    },
    {
     "do": "pad_tap",
     "btn": "X"
    },
    {
     "do": "wait",
     "s": 0.6
    },
    {
     "do": "walk",
     "who": 2,
     "to": "expr:relay_throw_spot()",
     "arrive": 0.5,
     "max": 30
    },
    {
     "do": "look",
     "who": 2,
     "at": "expr:relay_crust(1)"
    },
    {
     "do": "wait",
     "s": 0.6
    },
    {
     "do": "pad_tap",
     "btn": "RB"
    },
    {
     "do": "wait",
     "s": 1.6
    },
    {
     "do": "walk",
     "who": 2,
     "to": "expr:lk_at(-2.6, 0.2, 4.2)",
     "arrive": 0.5,
     "max": 30
    },
    {
     "do": "look",
     "who": 2,
