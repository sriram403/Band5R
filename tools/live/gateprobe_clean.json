    }
   ]
  },
  {
   "name": "2 a checking helper holds CTRL 1.5 s, ends and lets go",
   "max": 15,
   "do": [
    {
     "do": "spawn",
     "fn": "cancel_probe_bot",
     "args": [
      1.5,
      true
     ]
    },
    {
     "do": "wait",
     "s": 2.5
    }
   ],
   "expect": [
    {
     "name": "helper done, CTRL released",
     "expr": "helpers_running == 0 and not ctrl_held()",
     "within": 3
    }
   ]
  }
 ]
}