{
 "name": "tapbench",
 "setup": [],
 "steps": [
  {
   "name": "1 F1 Puzzles: the ghat: both in the van at the foot of the hairpins",
   "max": 25,
   "do": [
    {
     "do": "menu",
     "tab": "Puzzles",
     "row": "The ghat pace notes"
    },
    {
     "do": "wait",
     "s": 3.0
    }
   ],
   "expect": [
    {
     "name": "both in, no Problem yet",
     "expr": "p1().seat != null and p2().seat != null and gh().phase == ''",
     "within": 4
    }
   ]
  },
  {
   "name": "2 alone: 20 N taps",
   "max": 40,
   "do": [
    {
     "do": "call",
     "fn": "tap_bench",
     "args": [
      20,
      "alone",
      0.8
     ]
    }
   ],
   "expect": [
    {
     "name": "alone bench logged",
     "expr": "bench_lines.size() >= 21",
     "within": 2
    }
   ]
  },
  {
   "name": "3 beside: 20 N taps while a second game comes up",
   "max": 45,
   "do": [
    {
     "do": "wait",
     "s": 1.0
    },
    {
     "do": "call",
     "fn": "tap_bench",
     "args": [
      20,
      "beside",
      0.8
     ]
    }
   ],
   "expect": [
    {
     "name": "beside bench logged",
     "expr": "bench_lines.size() >= 42",
     "within": 2
    }
   ]
  },
  {
   "name": "4 end",
   "max": 10,
   "do": [
    {
     "do": "wait",
     "s": 0.5
    }
   ],
   "expect": []
  }
 ]
}