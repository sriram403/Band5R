{
 "name": "puzzle5",
 "setup": [
  {
   "do": "eval",
   "expr": "boot._on_joy_changed(0, true)"
  }
 ],
 "steps": [
  {
   "name": "5.0 F1 Puzzles: the lift bridge",
   "max": 20,
   "do": [
    {
     "do": "menu",
     "tab": "Puzzles",
     "row": "The lift bridge"
    },
    {
     "do": "wait",
     "s": 2.0
    },
    {
     "do": "eval",
     "expr": "lb().gate.set('_wind_t', 99999.0)"
    },
    {
     "do": "wait",
     "s": 1.0
    }
   ],
   "expect": [
    {
     "name": "at rest: far end up 12 degrees, four blocks",
     "expr": "absf(lb().angle - 12.0) < 0.1 and lb().carts.size() == 4",
     "within": 3
    }
   ]
  },
  {
   "name": "5.1 both out; from the road the far end is up",
   "max": 60,
   "do": [
    {
     "do": "tap",
     "key": "E"
    },
    {
     "do": "wait",
     "s": 1.0
    },
    {
     "do": "pad_tap",
     "btn": "X"
    },
    {
     "do": "wait",
     "s": 1.5
    },
    {
     "do": "walk",
     "who": 1,
     "to": "expr:lb().global_transform * Vector3(-1.5, 0.0, 13.0)",
     "arrive": 0.6,
     "max": 40
    },
    {
     "do": "walk",
     "who": 2,
     "to": "expr:lb().global_transform * Vector3(1.8, 0.0, 13.0)",
     "arrive": 0.6,
     "max": 40
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:lb().global_transform * Vector3(0, 0.5, -5.0)"
    },
    {
     "do": "wait",
     "s": 0.4
    },
    {
     "do": "look",
     "who": 2,
     "at": "expr:lb().global_transform * Vector3(0, 0.5, -5.0)"
    },
    {
     "do": "wait",
     "s": 3.0
    }
   ],
   "expect": [
    {
     "name": "both on the road by the bridge",
     "expr": "(lb().global_transform.affine_inverse() * p1().global_position).z > 9.0",
     "within": 2
    }
   ]
  },
  {
   "name": "5.2 P1 walks out past the middle: it tips down",
   "max": 40,
   "do": [
    {
     "do": "walk",
     "who": 1,
     "to": "expr:lb().global_transform * Vector3(-1.5, 0.0, -8.6)",
     "arrive": 0.4,
     "max": 30
    },
    {
     "do": "until",
     "expr": "lb().angle < -2.0",
     "max": 12
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:lb().global_transform * Vector3(0, 0.0, -14.0)"
    },
    {
     "do": "wait",
     "s": 0.4
    },
    {
     "do": "look",
     "who": 2,
     "at": "expr:lb().global_transform * Vector3(0, 0.5, -5.0)"
    },
    {
     "do": "wait",
     "s": 2.0
    }
   ],
   "expect": [
    {
     "name": "the far end went down",
     "expr": "lb().angle < 0.0",
     "within": 2
    }
   ]
  },
  {
   "name": "5.3 P1 walks back past the middle: it tips up",
   "max": 40,
   "do": [
    {
     "do": "walk",
     "who": 1,
     "to": "expr:lb().global_transform * Vector3(-1.5, 0.0, -1.5)",
     "arrive": 0.4,
     "max": 30
    },
    {
     "do": "until",
     "expr": "lb().angle > 10.0",
     "max": 12
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:lb().global_transform * Vector3(0, 0.5, -5.0)"
    },
    {
     "do": "wait",
     "s": 1.5
    }
   ],
   "expect": [
    {
     "name": "the far end is back up",
     "expr": "lb().angle > 8.0",
     "within": 2
    }
   ]
  },
  {
   "name": "5.4 P2 stays on the near half as weight; P1 walks to the far end: it holds",
   "max": 60,
   "do": [
    {
     "do": "walk",
     "who": 2,
     "to": "expr:lb().global_transform * Vector3(1.5, 0.0, -1.5)",
     "arrive": 0.4,
     "max": 30
    },
    {
     "do": "walk",
     "who": 1,
     "to": "expr:lb().global_transform * Vector3(-1.5, 0.0, -9.4)",
     "arrive": 0.4,
     "max": 30
    },
    {
     "do": "wait",
     "s": 3.0
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:lb().hut.global_position"
    },
    {
     "do": "wait",
     "s": 2.0
    }
   ],
   "expect": [
    {
     "name": "still up with one on each half",
     "expr": "lb().angle > 4.0",
     "within": 2
    }
   ]
  },
  {
   "name": "5.5 P2 walks out to the far half too: down it goes",
   "max": 40,
   "do": [
    {
     "do": "walk",
     "who": 2,
     "to": "expr:lb().global_transform * Vector3(1.5, 0.0, -8.0)",
     "arrive": 0.4,
     "max": 30
    },
    {
     "do": "until",
     "expr": "lb().angle < -2.0",
     "max": 12
    },
    {
     "do": "wait",
     "s": 1.5
    }
   ],
   "expect": [
    {
     "name": "both on the far half: down",
     "expr": "lb().angle < 0.0",
     "within": 2
    }
   ]
  },
  {
   "name": "5.6 both walk back off: it swings and settles up",
   "max": 60,
   "do": [
    {
     "do": "walk",
     "who": 1,
     "to": "expr:lb().global_transform * Vector3(-1.8, 0.0, 12.0)",
     "arrive": 0.6,
     "max": 30
    },
    {
     "do": "walk",
     "who": 2,
     "to": "expr:lb().global_transform * Vector3(1.8, 0.0, 12.0)",
     "arrive": 0.6,
     "max": 30
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:lb().global_transform * Vector3(0, 0.5, -5.0)"
    },
    {
     "do": "wait",
     "s": 0.4
    },
    {
     "do": "look",
     "who": 2,
     "at": "expr:lb().global_transform * Vector3(0, 0.5, -5.0)"
    },
    {
     "do": "wait",
     "s": 0.4
    },
    {
     "do": "until",
     "expr": "lb().angle > 11.9",
     "max": 20
    }
   ],
   "expect": [
    {
     "name": "empty: back at rest",
     "expr": "lb().angle > 11.5",
     "within": 3
    }
   ]
  },
  {
   "name": "5.7 P2 pushes the 300 kg block out on the far half: it tips on its own",
   "max": 60,
   "do": [
    {
     "do": "walk",
     "who": 2,
     "to": "expr:lb().global_transform * Vector3(lb().carts[3]['rail'] * 2.4, 0, lb().carts[3]['z'] + 1.3)",
     "arrive": 0.4,
     "max": 30
    },
    {
     "do": "call",
     "fn": "place_player",
     "args": [
      "p2",
      "expr:lb().carts[3]['node'].global_position + lb().global_transform.basis.z * 1.3 + Vector3(0, 0.4, 0)",
      0.0
     ]
    },
    {
     "do": "wait",
     "s": 0.3
    },
    {
     "do": "look",
     "who": 2,
     "at": "expr:lb().carts[3]['node'].global_position + Vector3(0, 0.6, 0)"
    },
    {
     "do": "wait",
     "s": 0.4
    },
    {
     "do": "pad_down",
     "btn": "X"
    },
    {
     "do": "pad_axis",
     "axis": "LY",
     "v": -0.6
    },
    {
     "do": "until",
     "expr": "float(lb().carts[3]['z']) < -6.8 or lb().angle < 0.0",
     "max": 45
    },
    {
     "do": "pad_axis",
     "axis": "LY",
     "v": 0.0
    },
    {
     "do": "pad_up",
     "btn": "X"
    },
    {
     "do": "walk",
     "who": 2,
     "to": "expr:lb().global_transform * Vector3(1.8, 0.0, -4.0)",
     "arrive": 0.5,
     "max": 20
    },
    {
     "do": "look",
     "who": 2,
     "at": "expr:lb().global_transform * Vector3(0, 0.5, -5.0)"
    },
    {
     "do": "wait",
     "s": 0.4
    },
    {
     "do": "until",
     "expr": "lb().angle < 0.0",
     "max": 15
    },
    {
     "do": "wait",
     "s": 2.0
    }
   ],
   "expect": [
    {
     "name": "the block out on the far half tips it down",
     "expr": "lb().angle < 0.0",
     "within": 3
    }
   ]
  },
  {
   "name": "5.8 the block back, the van creeps on with nothing behind it: past the middle into the pit",
   "max": 120,
   "do": [
    {
     "do": "eval",
     "expr": "lb().reset_bridge()"
    },
    {
     "do": "eval",
     "expr": "lb().gate.set('_wind_t', 99999.0)"
    },
    {
     "do": "wait",
     "s": 1.0
    },
    {
     "do": "walk",
     "who": 2,
     "to": "expr:lb().global_transform * Vector3(3.2, 0.0, 16.0)",
     "arrive": 0.6,
     "max": 30
    },
    {
     "do": "look",
     "who": 2,
     "at": "expr:lb().global_transform * Vector3(0, 0.5, -5.0)"
    },
    {
     "do": "wait",
     "s": 0.3
    },
    {
     "do": "call",
     "fn": "seat_p1_driver"
    },
    {
     "do": "wait",
     "s": 1.0
    },
    {
     "do": "tap",
     "key": "X"
    },
    {
     "do": "wait",
     "s": 1.5
    },
    {
     "do": "tap",
     "key": "SPACE"
    },
    {
     "do": "wait",
     "s": 0.5
    },
    {
     "do": "drive",
     "road": "pump_house_road",
     "to": "expr:lb().global_transform * Vector3(0, 0.0, -14.0)",
     "until": "lb().failing",
     "max": 90,
     "kmh": 6
    },
    {
     "do": "until",
     "expr": "lb().failing",
     "max": 15
    },
    {
     "do": "wait",
     "s": 5.0
    }
   ],
   "expect": [
    {
     "name": "into the pit, back at the gate",
     "expr": "camper().global_position.distance_to(lb().van_start.origin) < 3.0",
     "within": 6
    }
   ]
  }
 ]
}