{
 "name": "puzzle5",
 "setup": [
  {
   "do": "eval",
   "expr": "boot._on_joy_changed(0, true)"
  }
 ],
 "steps": [
  {
   "name": "5.0 F1 Puzzles: the lift bridge",
   "do": [
    {
     "do": "menu",
     "tab": "Puzzles",
     "row": "The lift bridge"
    },
    {
     "do": "wait",
     "s": 2.0
    }
   ],
   "expect": [
    {
     "name": "fresh: the leaf up, the house barred",
     "expr": "lb().angle > 29.9 and not lb().door_open and not lb().locked",
     "within": 3
    }
   ]
  },
  {
   "name": "5.1 both out of the van; P1 tries the hut's levers and reads Naresh's note",
   "max": 70,
   "do": [
    {
     "do": "tap",
     "key": "E"
    },
    {
     "do": "wait",
     "s": 1.0
    },
    {
     "do": "pad_tap",
     "btn": "X"
    },
    {
     "do": "wait",
     "s": 1.5
    },
    {
     "do": "walk",
     "who": 1,
     "to": "expr:boot.builder.poi['bridge_hut_door']",
     "arrive": 0.6,
     "max": 30
    },
    {
     "do": "walk",
     "who": 1,
     "to": "expr:lb_panel_stand()",
     "arrive": 0.4,
     "max": 10
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:lb().find_child('LOWERLever', true, false).global_position"
    },
    {
     "do": "wait",
     "s": 2.5
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:lb().find_child('NareshNote_lb_hut', true, false).global_position"
    },
    {
     "do": "wait",
     "s": 0.4
    },
    {
     "do": "tap",
     "key": "E"
    },
    {
     "do": "wait",
     "s": 8.0
    }
   ],
   "expect": [
    {
     "name": "his note read: a seesaw",
     "expr": "lb_note_read('lb_hut')",
     "within": 2
    }
   ]
  },
  {
   "name": "5.2 P2 at the machinery house: barred; Naresh's note by the door",
   "max": 60,
   "do": [
    {
     "do": "walk",
     "who": 2,
     "to": "expr:boot.builder.poi['bridge_barrier_near'] - lb().global_transform.basis.x * lb().m * 7.0",
     "arrive": 0.8,
     "max": 30
    },
    {
     "do": "walk",
     "who": 2,
     "to": "expr:lb().global_transform * Vector3(0, 0.1, 4.0)",
     "arrive": 0.8,
     "max": 20
    },
    {
     "do": "walk",
     "who": 2,
     "to": "expr:boot.builder.poi['machinery_door']",
     "arrive": 0.5,
     "max": 30
    },
    {
     "do": "look",
     "who": 2,
     "at": "expr:lb_door_look()"
    },
    {
     "do": "wait",
     "s": 2.5
    },
    {
     "do": "look",
     "who": 2,
     "at": "expr:lb().find_child('NareshNote_lb_door', true, false).global_position"
    },
    {
     "do": "wait",
     "s": 0.4
    },
    {
     "do": "pad_tap",
     "btn": "X"
    },
    {
     "do": "wait",
     "s": 7.0
    }
   ],
   "expect": [
    {
     "name": "his note read: a leg-up",
     "expr": "lb_note_read('lb_door')",
     "within": 2
    }
   ]
  },
  {
   "name": "5.3 the leg-up: P2 crouches under the hatch, P1 jumps up off their back",
   "max": 70,
   "do": [
    {
     "do": "walk",
     "who": 2,
     "to": "expr:lb_hatch(0.0)",
     "arrive": 0.3,
     "max": 15
    },
    {
     "do": "look",
     "who": 2,
     "at": "expr:lb_hatch(2.0) + Vector3(0, 1.0, 0)"
    },
    {
     "do": "wait",
     "s": 0.4
    },
    {
     "do": "pad_down",
     "btn": "B"
    },
    {
     "do": "wait",
     "s": 1.0
    },
    {
     "do": "walk",
     "who": 1,
     "to": "expr:lb_hatch(-1.6)",
     "arrive": 0.5,
     "max": 40
    },
    {
     "do": "walk",
     "who": 1,
     "to": "expr:lb_hatch(-0.85)",
     "arrive": 0.25,
     "max": 6
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:lb_hatch(2.0) + Vector3(0, 2.2, 0)"
    },
    {
     "do": "wait",
     "s": 1.5
    },
    {
     "do": "down",
     "key": "W"
    },
    {
     "do": "tap",
     "key": "Space"
    },
    {
     "do": "wait",
     "s": 1.4
    },
    {
     "do": "up",
     "key": "W"
    },
    {
     "do": "pad_up",
     "btn": "B"
    },
    {
     "do": "wait",
     "s": 1.0
    }
   ],
   "expect": [
    {
     "name": "P1 in through the hatch",
     "expr": "lb()._inside_house(p1())",
     "within": 3
    }
   ]
  },
  {
   "name": "5.4 P1 lifts the bar and opens the door; the lock won't go with the leaf up",
   "max": 60,
   "do": [
    {
     "do": "walk",
     "who": 1,
     "to": "expr:boot.builder.poi['machinery_in']",
     "arrive": 0.5,
     "max": 10
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:lb_door_look()"
    },
    {
     "do": "wait",
     "s": 0.4
    },
    {
     "do": "tap",
     "key": "E"
    },
    {
     "do": "wait",
     "s": 1.5
    },
    {
     "do": "walk",
     "who": 1,
     "to": "expr:boot.builder.poi['machinery_mid']",
     "arrive": 0.5,
     "max": 10
    },
    {
     "do": "walk",
     "who": 1,
     "to": "expr:boot.builder.poi['lock_lever']",
     "arrive": 0.5,
     "max": 10
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:lb().find_child('LockArea', true, false).global_position"
    },
    {
     "do": "wait",
     "s": 3.0
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:lb().find_child('NareshNote_lb_lock', true, false).global_position"
    },
    {
     "do": "wait",
     "s": 0.4
    },
    {
     "do": "tap",
     "key": "E"
    },
    {
     "do": "wait",
     "s": 8.0
    }
   ],
   "expect": [
    {
     "name": "the door open; still up",
     "expr": "lb().door_open and lb().angle > 29.9",
     "within": 2
    }
   ]
  },
  {
   "name": "5.5 a stone from the crew's heap, dropped by the axle: nothing",
   "max": 70,
   "do": [
    {
     "do": "walk",
     "who": 1,
     "to": "expr:boot.builder.poi['machinery_mid']",
     "arrive": 0.5,
     "max": 10
    },
    {
     "do": "walk",
     "who": 1,
     "to": "expr:boot.builder.poi['machinery_door']",
     "arrive": 0.5,
     "max": 15
    },
    {
     "do": "walk",
     "who": 1,
     "to": "expr:lb_stone(boot.builder.poi['stone_heap'])",
     "arrive": 1.1,
     "max": 15
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:lb_stone(boot.builder.poi['stone_heap'])"
    },
    {
     "do": "wait",
     "s": 0.4
    },
    {
     "do": "tap",
     "key": "E"
    },
    {
     "do": "wait",
     "s": 0.8
    },
    {
     "do": "walk",
     "who": 1,
     "to": "expr:leaf_at(lb(), 1.2, 0.0)",
     "arrive": 0.4,
     "max": 15
    },
    {
     "do": "tap",
     "key": "E"
    },
    {
     "do": "wait",
     "s": 1.5
    },
    {
     "do": "walk",
     "who": 1,
     "to": "expr:boot.builder.poi['stone_heap']",
     "arrive": 1.6,
     "max": 15
    },
    {
     "do": "wait",
     "s": 2.0
    }
   ],
   "expect": [
    {
     "name": "still up",
     "expr": "lb().angle > 29.9",
     "within": 2
    }
   ]
  },
  {
   "name": "5.6 P1 carries a stone up to the tip: still nothing",
   "max": 70,
   "do": [
    {
     "do": "walk",
     "who": 1,
     "to": "expr:lb_stone(boot.builder.poi['stone_heap'])",
     "arrive": 1.1,
     "max": 15
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:lb_stone(boot.builder.poi['stone_heap'])"
    },
    {
     "do": "wait",
     "s": 0.4
    },
    {
     "do": "tap",
     "key": "E"
    },
    {
     "do": "wait",
     "s": 0.8
    },
    {
     "do": "walk",
     "who": 1,
     "to": "expr:leaf_at(lb(), 8.6, -1.0)",
     "arrive": 0.4,
     "max": 25
    },
    {
     "do": "tap",
     "key": "E"
    },
    {
     "do": "wait",
     "s": 1.0
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:boot.builder.poi['stone_heap']"
    },
    {
     "do": "wait",
     "s": 3.0
    }
   ],
   "expect": [
    {
     "name": "still up with P1 and a stone at the tip",
     "expr": "lb().angle > 29.9 and lb_stones_out() >= 1",
     "within": 2
    }
   ]
  },
  {
   "name": "5.7 P2 brings a second stone out, slowly: down it comes, gently",
   "max": 80,
   "do": [
    {
     "do": "walk",
     "who": 2,
     "to": "expr:lb_stone(boot.builder.poi['stone_heap'])",
     "arrive": 1.1,
     "max": 15
    },
    {
     "do": "look",
     "who": 2,
     "at": "expr:lb_stone(boot.builder.poi['stone_heap'])"
    },
    {
     "do": "wait",
     "s": 0.4
    },
    {
     "do": "pad_tap",
     "btn": "X"
    },
    {
     "do": "wait",
     "s": 0.8
    },
    {
     "do": "walk",
     "who": 2,
     "to": "expr:leaf_at(lb(), 5.0, 1.0)",
     "arrive": 0.4,
     "max": 25
    },
    {
     "do": "until",
     "expr": "lb().angle < 0.1",
     "max": 25
    },
    {
     "do": "wait",
     "s": 1.5
    }
   ],
   "expect": [
    {
     "name": "down on the far bank, no slam",
     "expr": "lb().angle < 0.1 and lb().slams == 0",
     "within": 2
    }
   ]
  },
  {
   "name": "5.8 P2's stone to the tip; P2 walks off: P1 and two stones hold it",
   "max": 70,
   "do": [
    {
     "do": "walk",
     "who": 2,
     "to": "expr:leaf_at(lb(), 8.3, 1.0)",
     "arrive": 0.4,
     "max": 15
    },
    {
     "do": "pad_tap",
     "btn": "X"
    },
    {
     "do": "wait",
     "s": 1.0
    },
    {
     "do": "walk",
     "who": 2,
     "to": "expr:boot.builder.poi['machinery_door']",
     "arrive": 0.6,
     "max": 30
    },
    {
     "do": "wait",
     "s": 2.0
    }
   ],
   "expect": [
    {
     "name": "still down",
     "expr": "lb().angle < 0.1",
     "within": 2
    }
   ]
  },
  {
   "name": "5.9 P2 throws the lock: CLANK",
   "max": 50,
   "do": [
    {
     "do": "walk",
     "who": 2,
     "to": "expr:boot.builder.poi['machinery_in']",
     "arrive": 0.5,
     "max": 10
    },
    {
     "do": "walk",
     "who": 2,
     "to": "expr:boot.builder.poi['machinery_mid']",
     "arrive": 0.5,
     "max": 10
    },
    {
     "do": "walk",
     "who": 2,
     "to": "expr:boot.builder.poi['lock_lever']",
     "arrive": 0.5,
     "max": 10
    },
    {
     "do": "look",
     "who": 2,
     "at": "expr:lb().find_child('LockArea', true, false).global_position"
    },
    {
     "do": "wait",
     "s": 0.4
    },
    {
     "do": "pad_tap",
     "btn": "X"
    },
    {
     "do": "wait",
     "s": 4.0
    }
   ],
   "expect": [
    {
     "name": "locked; the barriers gone",
     "expr": "lb().locked and not boot.builder.bridge_barriers.visible",
     "within": 2
    }
   ]
  },
  {
   "name": "5.10 the fun: P1 jumps over the kerb into the river and swims out",
   "max": 80,
   "do": [
    {
     "do": "walk",
     "who": 1,
     "to": "expr:leaf_at(lb(), 5.0, -lb().deck_w * 0.5 + 1.0)",
     "arrive": 0.4,
     "max": 15
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:lb().leaf.global_transform * Vector3(-8.0, 0.0, -5.0)"
    },
    {
     "do": "wait",
     "s": 0.4
    },
    {
     "do": "down",
     "key": "W"
    },
    {
     "do": "wait",
     "s": 0.25
    },
    {
     "do": "tap",
     "key": "Space"
    },
    {
     "do": "wait",
     "s": 1.5
    },
    {
     "do": "up",
     "key": "W"
    },
    {
     "do": "until",
     "expr": "not p1().swimming and p1().wet_t > 0.0",
     "max": 50
    },
    {
     "do": "wait",
     "s": 3.0
    }
   ],
   "expect": [
    {
     "name": "out on the bank, soaked",
     "expr": "p1().wet_t > 0.0 and not p1().swimming",
     "within": 3
    }
   ]
  }
 ]
}