{
 "name": "puzzle5c",
 "setup": [
  {
   "do": "eval",
   "expr": "boot._on_joy_changed(0, true)"
  }
 ],
 "steps": [
  {
   "name": "5.0 F1 Puzzles: the lift bridge",
   "max": 20,
   "do": [
    {
     "do": "menu",
     "tab": "Puzzles",
     "row": "The lift bridge"
    },
    {
     "do": "wait",
     "s": 2.0
    },
    {
     "do": "eval",
     "expr": "lb().gate.set('_wind_t', 99999.0)"
    },
    {
     "do": "wait",
     "s": 1.0
    }
   ],
   "expect": [
    {
     "name": "at rest: far end up 12 degrees, four blocks",
     "expr": "absf(lb().angle - 12.0) < 0.1 and lb().carts.size() == 4",
     "within": 3
    }
   ]
  },
  {
   "name": "5.1b both out, by the bridge",
   "max": 60,
   "do": [
    {
     "do": "tap",
     "key": "E"
    },
    {
     "do": "wait",
     "s": 1.0
    },
    {
     "do": "pad_tap",
     "btn": "X"
    },
    {
     "do": "wait",
     "s": 1.5
    },
    {
     "do": "walk",
     "who": 1,
     "to": "expr:lb().global_transform * Vector3(-1.8, 0.0, 13.0)",
     "arrive": 0.6,
     "max": 40
    },
    {
     "do": "walk",
     "who": 2,
     "to": "expr:lb().global_transform * Vector3(1.8, 0.0, 13.0)",
     "arrive": 0.6,
     "max": 40
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:lb().global_transform * Vector3(0, 0.5, -5.0)"
    },
    {
     "do": "wait",
     "s": 0.4
    },
    {
     "do": "look",
     "who": 2,
     "at": "expr:lb().global_transform * Vector3(0, 0.5, -5.0)"
    },
    {
     "do": "wait",
     "s": 0.4
    }
   ],
   "expect": []
  },
  {
   "name": "5.8 the block back, the van creeps on with nothing behind it: past the middle into the pit",
   "max": 120,
   "do": [
    {
     "do": "eval",
     "expr": "lb().reset_bridge()"
    },
    {
     "do": "eval",
     "expr": "lb().gate.set('_wind_t', 99999.0)"
    },
    {
     "do": "wait",
     "s": 1.0
    },
    {
     "do": "walk",
     "who": 2,
     "to": "expr:lb().global_transform * Vector3(3.2, 0.0, 16.0)",
     "arrive": 0.6,
     "max": 30
    },
    {
     "do": "look",
     "who": 2,
     "at": "expr:lb().global_transform * Vector3(0, 0.5, -5.0)"
    },
    {
     "do": "wait",
     "s": 0.3
    },
    {
     "do": "call",
     "fn": "seat_p1_driver"
    },
    {
     "do": "wait",
     "s": 1.0
    },
    {
     "do": "tap",
     "key": "X"
    },
    {
     "do": "wait",
     "s": 1.5
    },
    {
     "do": "tap",
     "key": "SPACE"
    },
    {
     "do": "wait",
     "s": 0.5
    },
    {
     "do": "call",
     "fn": "creep_careful",
     "args": [
      90.0
     ]
    },
    {
     "do": "until",
     "expr": "lb().failing",
     "max": 15
    },
    {
     "do": "wait",
     "s": 5.0
    }
   ],
   "expect": [
    {
     "name": "into the pit, back at the gate",
     "expr": "camper().global_position.distance_to(lb().van_start.origin) < 3.0",
     "within": 6
    }
   ]
  }
 ]
}