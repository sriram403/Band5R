{
 "name": "ghat",
 "setup": [
  {
   "do": "eval",
   "expr": "boot._on_joy_changed(0, true)"
  }
 ],
 "steps": [
  {
   "name": "1 F1 Puzzles: the ghat: both in the van at the foot of the hairpins",
   "max": 25,
   "do": [
    {
     "do": "menu",
     "tab": "Puzzles",
     "row": "The ghat pace notes"
    },
    {
     "do": "wait",
     "s": 2.0
    }
   ],
   "expect": [
    {
     "name": "both in, no Problem yet",
     "expr": "p1().seat != null and p2().seat != null and gh().phase == ''",
     "within": 4
    }
   ]
  },
  {
   "name": "2 P2 swings the nav to read the pace notes; the engine on",
   "max": 15,
   "do": [
    {
     "do": "pad_tap",
     "btn": "A"
    },
    {
     "do": "wait",
     "s": 1.0
    },
    {
     "do": "hold",
     "key": "X",
     "s": 0.3
    },
    {
     "do": "wait",
     "s": 1.0
    }
   ],
   "expect": [
    {
     "name": "nav swung, engine on",
     "expr": "camper().nav_aside and camper().engine_on",
     "within": 6
    }
   ]
  },
  {
   "name": "3 up the hill into the fog, stop at the old milestone",
   "max": 100,
   "do": [
    {
     "do": "drive",
     "road": "ghat_road",
     "to": "expr:gh().road.point(199)",
     "kmh": 30,
     "max": 90
    },
    {
     "do": "hold",
     "key": "X",
     "s": 0.3
    },
    {
     "do": "wait",
     "s": 0.5
    }
   ],
   "expect": [
    {
     "name": "stopped by the milestone, parked",
     "expr": "camper().global_position.distance_to(boot.builder.poi['ghat_milestone']) < 18.0 and camper().parking_brake",
     "within": 95
    }
   ]
  },
  {
   "name": "4 P1 out: Naresh's note on the milestone",
   "max": 40,
   "do": [
    {
     "do": "tap",
     "key": "E"
    },
    {
     "do": "wait",
     "s": 0.6
    },
    {
     "do": "walk",
     "who": 1,
     "to": "expr:note_stand()",
     "arrive": 0.4,
     "max": 20
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:note_at()"
    },
    {
     "do": "wait",
     "s": 0.5
    },
    {
     "do": "tap",
     "key": "E"
    },
    {
     "do": "wait",
     "s": 7.0
    }
   ],
   "expect": [
    {
     "name": "the note read",
     "expr": "note_read('ghat_heat')",
     "within": 35
    }
   ]
  },
  {
   "name": "5 back in, on up the hairpins",
   "max": 30,
   "do": [
    {
     "do": "walk",
     "who": 1,
     "to": "expr:van_side(-2.6, -1.8)",
     "arrive": 0.6,
     "max": 20
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:van_side(-1.2, -1.8, 1.4)"
    },
    {
     "do": "wait",
     "s": 0.3
    },
    {
     "do": "tap",
     "key": "E"
    },
    {
     "do": "wait",
     "s": 0.8
    },
    {
     "do": "hold",
     "key": "X",
     "s": 0.3
    },
    {
     "do": "wait",
     "s": 0.8
    }
   ],
   "expect": [
    {
     "name": "P1 driving again",
     "expr": "p1().seat_role == 'driver' and camper().engine_on",
     "within": 25
    }
   ]
  },
  {
   "name": "6 hairpin 1: something tall in the trees turns its head to follow the van; the needle climbs; the engine dies in the fog",
   "max": 120,
   "do": [
    {
     "do": "drive",
     "road": "ghat_road",
     "until": "gh().phase == 'watch'",
     "kmh": 28,
     "max": 60
    },
    {
     "do": "look",
     "who": 2,
     "at": "expr:gh().problem.eye_point()"
    },
    {
     "do": "drive",
     "road": "ghat_road",
     "until": "camper().boiled_dry",
     "kmh": 30,
     "max": 60
    },
    {
     "do": "wait",
     "s": 1.0
    }
   ],
   "expect": [
    {
     "name": "seen, boiled dry, parked",
     "expr": "gh().seen_index > 0 and camper().boiled_dry and camper().linear_velocity.length() < 0.5 and camper().parking_brake",
     "within": 115
    }
   ]
  },
  {
   "name": "7 both out: the old shade net over the van, one corner each",
   "max": 40,
   "do": [
    {
     "do": "tap",
     "key": "E"
    },
    {
     "do": "wait",
     "s": 0.5
    },
    {
     "do": "pad_tap",
     "btn": "X"
    },
    {
     "do": "wait",
     "s": 0.8
    },
    {
     "do": "call",
     "fn": "_to_tarp_corner",
     "args": [
      "p1",
      "expr:camper()",
      -1.0
     ]
    },
    {
     "do": "hold",
     "key": "E",
     "s": 2.2
    },
    {
     "do": "call",
     "fn": "_to_tarp_corner",
     "args": [
      "p2",
      "expr:camper()",
      1.0
     ]
    },
    {
     "do": "pad_hold",
     "btn": "X",
     "s": 2.6
    },
    {
     "do": "wait",
     "s": 0.2
    }
   ],
   "expect": [
    {
     "name": "the van under the net",
     "expr": "camper().attack.tarped",
     "within": 35
    }
   ]
  },
  {
   "name": "8 both back in, keep still",
   "max": 30,
   "do": [
    {
     "do": "call",
     "fn": "_to_door",
     "args": [
      "p1",
      "expr:camper()",
      "driver"
     ]
    },
    {
     "do": "tap",
     "key": "E"
    },
    {
     "do": "wait",
     "s": 0.2
    },
    {
     "do": "call",
     "fn": "_to_door",
     "args": [
      "p2",
      "expr:camper()",
      "passenger"
     ]
    },
    {
     "do": "pad_tap",
     "btn": "X"
    },
    {
     "do": "wait",
     "s": 0.5
    }
   ],
   "expect": [
    {
     "name": "both hidden inside",
     "expr": "p1().seat_role == 'driver' and p2().seat_role == 'passenger'",
     "within": 25
    }
   ]
  },
  {
   "name": "9 it comes out of the fog, goes round the van, leans in at the windows (hold your breath), sniffs at the back, and gives up",
   "max": 200,
   "do": [
    {
     "do": "spawn",
     "fn": "walk_breath_bot",
     "args": [
      190.0
     ]
    },
    {
     "do": "until",
     "expr": "gh().phase == 'leave'",
     "max": 190
    },
    {
     "do": "wait",
     "s": 4.0
    }
   ],
   "expect": [
    {
     "name": "it gave up, nothing given away",
     "expr": "gh().phase == 'leave' and gh().breath_events == 0",
     "within": 195
    }
   ]
  },
  {
   "name": "10 out, net off; P1 opens the radiator cap while it still hisses: WHOOSH, and it hears",
   "max": 40,
   "do": [
    {
     "do": "tap",
     "key": "E"
    },
    {
     "do": "wait",
     "s": 0.5
    },
    {
     "do": "pad_tap",
     "btn": "X"
    },
    {
     "do": "wait",
     "s": 0.8
    },
    {
     "do": "call",
     "fn": "_to_tarp_corner",
     "args": [
      "p1",
      "expr:camper()",
      -1.0
     ]
    },
    {
     "do": "hold",
     "key": "E",
     "s": 2.6
    },
    {
     "do": "wait",
     "s": 0.4
    },
    {
     "do": "call",
     "fn": "place_player",
     "args": [
      "p1",
      "expr:bonnet_stand()",
      0.0
     ]
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:bonnet_at()"
    },
    {
     "do": "wait",
     "s": 0.4
    },
    {
     "do": "tap",
     "key": "E"
    },
    {
     "do": "wait",
     "s": 3.0
    }
   ],
   "expect": [
    {
     "name": "the cap blew, it's coming back",
     "expr": "camper().cap_blows == 1 and camper().attack.interested()",
     "within": 35
    }
   ]
  },
  {
   "name": "11 net on again, in, hide well",
   "max": 60,
   "do": [
    {
     "do": "call",
     "fn": "_to_tarp_corner",
     "args": [
      "p1",
      "expr:camper()",
      -1.0
     ]
    },
    {
     "do": "hold",
     "key": "E",
     "s": 2.2
    },
    {
     "do": "call",
     "fn": "_to_tarp_corner",
     "args": [
      "p2",
      "expr:camper()",
      1.0
     ]
    },
    {
     "do": "pad_hold",
     "btn": "X",
     "s": 2.6
    },
    {
     "do": "wait",
     "s": 0.2
    },
    {
     "do": "call",
     "fn": "_to_door",
     "args": [
      "p1",
      "expr:camper()",
      "driver"
     ]
    },
    {
     "do": "tap",
     "key": "E"
    },
    {
     "do": "wait",
     "s": 0.2
    },
    {
     "do": "call",
     "fn": "_to_door",
     "args": [
      "p2",
      "expr:camper()",
      "passenger"
     ]
    },
    {
     "do": "pad_tap",
     "btn": "X"
    },
    {
     "do": "wait",
     "s": 0.5
    }
   ],
   "expect": [
    {
     "name": "hidden again",
     "expr": "camper().attack.tarped and p1().seat != null and p2().seat != null",
     "within": 55
    }
   ]
  },
  {
   "name": "12 it searches again, and gives up again",
   "max": 200,
   "do": [
    {
     "do": "spawn",
     "fn": "walk_breath_bot",
     "args": [
      190.0
     ]
    },
    {
     "do": "until",
     "expr": "gh().phase == 'leave'",
     "max": 190
    },
    {
     "do": "wait",
     "s": 4.0
    }
   ],
   "expect": [
    {
     "name": "it gave up again",
     "expr": "gh().phase == 'leave'",
     "within": 195
    }
   ]
  },
  {
   "name": "13 out, net off; P1 waits by the bonnet for the hissing to stop",
   "max": 30,
   "do": [
    {
     "do": "tap",
     "key": "E"
    },
    {
     "do": "wait",
     "s": 0.5
    },
    {
     "do": "pad_tap",
     "btn": "X"
    },
    {
     "do": "wait",
     "s": 0.8
    },
    {
     "do": "call",
     "fn": "_to_tarp_corner",
     "args": [
      "p1",
      "expr:camper()",
      -1.0
     ]
    },
    {
     "do": "hold",
     "key": "E",
     "s": 2.6
    },
    {
     "do": "wait",
     "s": 0.4
    },
    {
     "do": "call",
     "fn": "place_player",
     "args": [
      "p1",
      "expr:bonnet_stand()",
      0.0
     ]
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:bonnet_at()"
    },
    {
     "do": "wait",
     "s": 0.4
    }
   ],
   "expect": [
    {
     "name": "net off",
     "expr": "not camper().attack.tarped",
     "within": 25
    }
   ]
  },
  {
   "name": "14 P2 down the road to the spring: the pot, filled at the pipe, back to the van",
   "max": 120,
   "do": [
    {
     "do": "walk",
     "who": 2,
     "to": "expr:pot_stand()",
     "arrive": 0.7,
     "max": 50
    },
    {
     "do": "look",
     "who": 2,
     "at": "expr:pot_at() + Vector3(0, 0.15, 0)"
    },
    {
     "do": "wait",
     "s": 0.4
    },
    {
     "do": "pad_tap",
     "btn": "X"
    },
    {
     "do": "wait",
     "s": 0.6
    },
    {
     "do": "walk",
     "who": 2,
     "to": "expr:pipe_stand()",
     "arrive": 0.5,
     "max": 10
    },
    {
     "do": "look",
     "who": 2,
     "at": "expr:pipe_at()"
    },
    {
     "do": "wait",
     "s": 0.3
    },
    {
     "do": "pad_hold",
     "btn": "X",
     "s": 5.8
    },
    {
     "do": "wait",
     "s": 0.3
    },
    {
     "do": "walk",
     "who": 2,
     "to": "expr:van_side(3.0, 1.5)",
     "arrive": 0.8,
     "max": 50
    },
    {
     "do": "walk",
     "who": 2,
     "to": "expr:van_side(1.2, -5.6)",
     "arrive": 0.8,
     "max": 20
    }
   ],
   "expect": [
    {
     "name": "P2 holds a full pot",
     "expr": "p2().held != null and p2().held.litres > 2.3",
     "within": 110
    }
   ]
  },
  {
   "name": "15 the hissing stops",
   "max": 130,
   "do": [
    {
     "do": "until",
     "expr": "camper().temp <= 104.0",
     "max": 125
    }
   ],
   "expect": [
    {
     "name": "cool enough",
     "expr": "camper().temp <= 104.0",
     "within": 128
    }
   ]
  },
  {
   "name": "16 P2 pours the water into the radiator",
   "max": 30,
   "do": [
    {
     "do": "look",
     "who": 2,
     "at": "expr:bonnet_at()"
    },
    {
     "do": "wait",
     "s": 0.4
    },
    {
     "do": "pad_hold",
     "btn": "X",
     "s": 1.8
    },
    {
     "do": "wait",
     "s": 0.5
    }
   ],
   "expect": [
    {
     "name": "the water went in",
     "expr": "camper().coolant > 0.3",
     "within": 25
    }
   ]
  },
  {
   "name": "17 not full yet: P2 back down to the spring with the pot, fills it again",
   "max": 120,
   "do": [
    {
     "do": "walk",
     "who": 2,
     "to": "expr:pipe_stand()",
     "arrive": 0.5,
     "max": 50
    },
    {
     "do": "look",
     "who": 2,
     "at": "expr:pipe_at()"
    },
    {
     "do": "wait",
     "s": 0.3
    },
    {
     "do": "pad_hold",
     "btn": "X",
     "s": 5.8
    },
    {
     "do": "wait",
     "s": 0.3
    },
    {
     "do": "walk",
     "who": 2,
     "to": "expr:van_side(3.0, 1.5)",
     "arrive": 0.8,
     "max": 50
    },
    {
     "do": "walk",
     "who": 2,
     "to": "expr:van_side(1.2, -5.6)",
     "arrive": 0.8,
     "max": 20
    }
   ],
   "expect": [
    {
     "name": "P2 holds a full pot",
     "expr": "p2().held != null and p2().held.litres > 2.3",
     "within": 110
    }
   ]
  },
  {
   "name": "18 P2 pours the water into the radiator",
   "max": 30,
   "do": [
    {
     "do": "look",
     "who": 2,
     "at": "expr:bonnet_at()"
    },
    {
     "do": "wait",
     "s": 0.4
    },
    {
     "do": "pad_hold",
     "btn": "X",
     "s": 1.8
    },
    {
     "do": "wait",
     "s": 0.5
    }
   ],
   "expect": [
    {
     "name": "the water went in",
     "expr": "camper().coolant > 0.3",
     "within": 25
    }
   ]
  },
  {
   "name": "19 the radiator full again: in, start up, on over the pass",
   "max": 90,
   "do": [
    {
     "do": "walk",
     "who": 2,
     "to": "expr:van_side(3.6, -3.6)",
     "arrive": 0.8,
     "max": 20
    },
    {
     "do": "pad_tap",
     "btn": "X"
    },
    {
     "do": "wait",
     "s": 0.8
    },
    {
     "do": "walk",
     "who": 2,
     "to": "expr:van_side(2.9, -1.8)",
     "arrive": 0.6,
     "max": 10
    },
    {
     "do": "wait",
     "s": 0.3
    },
    {
     "do": "call",
     "fn": "_to_door",
     "args": [
      "p1",
      "expr:camper()",
      "driver"
     ]
    },
    {
     "do": "tap",
     "key": "E"
    },
    {
     "do": "wait",
     "s": 0.2
    },
    {
     "do": "call",
     "fn": "_to_door",
     "args": [
      "p2",
      "expr:camper()",
      "passenger"
     ]
    },
    {
     "do": "pad_tap",
     "btn": "X"
    },
    {
     "do": "wait",
     "s": 0.8
    },
    {
     "do": "hold",
     "key": "X",
     "s": 0.3
    },
    {
     "do": "wait",
     "s": 0.8
    },
    {
     "do": "drive",
     "road": "ghat_road",
     "kmh": 30,
     "max": 60
    }
   ],
   "expect": [
    {
     "name": "over the pass, running, both aboard",
     "expr": "boot.story.current()['id'] == 'to_tower' and camper().engine_on and p1().seat_role == 'driver' and p2().seat != null",
     "within": 85
    }
   ]
  },
  {
   "name": "20 stopped past the pass: the marks it left on the van",
   "max": 40,
   "do": [
    {
     "do": "tap",
     "key": "E"
    },
    {
     "do": "wait",
     "s": 0.6
    },
    {
     "do": "call",
     "fn": "place_player",
     "args": [
      "p1",
      "expr:van_side(-2.7, -1.6)",
      0.0
     ]
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:van_side(-1.15, -1.8, 1.85)"
    },
    {
     "do": "wait",
     "s": 3.0
    },
    {
     "do": "call",
     "fn": "place_player",
     "args": [
      "p1",
      "expr:van_side(-0.8, -5.8)",
      0.0
     ]
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:van_side(0, -3.3, 1.66)"
    },
    {
     "do": "wait",
     "s": 3.0
    },
    {
     "do": "call",
     "fn": "place_player",
     "args": [
      "p1",
      "expr:van_side(0.6, 5.8)",
      0.0
     ]
    },
    {
     "do": "look",
     "who": 1,
     "at": "expr:van_side(0, 3.0, 1.3)"
    },
    {
     "do": "wait",
     "s": 3.0
    }
   ],
   "expect": [
    {
     "name": "the marks are on the van",
     "expr": "camper().marks.size() >= 5",
     "within": 35
    }
   ]
  }
 ]
}